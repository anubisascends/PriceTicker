<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Filter Include="Source Files">
      <UniqueIdentifier>{a1000000-0000-0000-0000-000000000001}</UniqueIdentifier>
      <Extensions>cpp;c;cc;cxx</Extensions>
    </Filter>
    <Filter Include="Header Files">
      <UniqueIdentifier>{a1000000-0000-0000-0000-000000000002}</UniqueIdentifier>
      <Extensions>h;hpp;hxx</Extensions>
    </Filter>
    <Filter Include="Resource Files">
      <UniqueIdentifier>{a1000000-0000-0000-0000-000000000003}</UniqueIdentifier>
      <Extensions>r;rc;rcp</Extensions>
    </Filter>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="..\PriceTicker.cpp"><Filter>Source Files</Filter></ClCompile>
    <ClCompile Include="..\CardData.cpp"><Filter>Source Files</Filter></ClCompile>
    <ClCompile Include="..\TextRenderer.cpp"><Filter>Source Files</Filter></ClCompile>
    <ClCompile Include="$(PREMIERE_SDK_PATH)\Examples\Utils\MissingSuiteError.cpp"><Filter>Source Files</Filter></ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\PriceTicker.h"><Filter>Header Files</Filter></ClInclude>
    <ClInclude Include="..\CardData.h"><Filter>Header Files</Filter></ClInclude>
    <ClInclude Include="..\TextRenderer.h"><Filter>Header Files</Filter></ClInclude>
  </ItemGroup>
  <ItemGroup>
    <CustomBuild Include="..\PriceTicker.r"><Filter>Resource Files</Filter></CustomBuild>
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="..\PriceTicker.rc"><Filter>Resource Files</Filter></ResourceCompile>
  </ItemGroup>
</Project>
